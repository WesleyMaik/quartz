{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/public/engines",
      "!docs",
      "!.agents",
      "!.claude",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"] }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/document-core/**",
        "packages/messages/**",
        "packages/storage/**",
        "packages/compiler-core/**",
        "packages/compiler-typst/**",
        "packages/compiler-latex/**",
        "packages/agent-bridge/**",
        "packages/editor/**",
        "packages/project-format/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "React is only allowed in apps/web and packages/ui.",
                  "react-dom": "React is only allowed in apps/web and packages/ui."
                }
              }
            }
          }
        }
      }
    }
  ]
}
